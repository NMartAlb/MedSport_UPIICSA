# Copia este archivo como ".env" y cambia los valores. El archivo .env NO se sube a GitHub.

# Clave para firmar las sesiones: mínimo 32 caracteres aleatorios.
JWT_CLAVE=cambia-esto-por-una-frase-larga-y-aleatoria-de-mas-de-32-caracteres

# Clave para cifrar los documentos subidos: 32 bytes en Base64. Genérala con:  openssl rand -base64 32
CLAVE_CIFRADO_BASE64=
